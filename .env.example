# 复制成 .env 后填写。.env 不要提交进仓库。

# ---- 数据库 ----
# 生产用 PostgreSQL（Supabase 连接串把 postgresql:// 改成 postgresql+asyncpg://）
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres
# 本地开发可以直接用 SQLite
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# ---- 鉴权 ----
# 配了 JWT_SECRET 就默认进入 jwt 模式（安全默认）；不配则退回 dev 模式，
# 此时身份靠可伪造的 X-* 请求头，**绝不能用于公网**。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 显式覆盖：jwt = 只认 Bearer token；dev = 允许 X-* 头（本地用）
AUTH_MODE=

# ---- 卡密加密主密钥（必填，缺失会导致启动失败）----
# 生成：python -c "from backend.crypto import generate_master_key; print(generate_master_key())"
# 注意：换掉这个值会让已入库的卡密全部解不开，务必先备份。
MASTER_KEY=

# ---- 前端来源白名单（逗号分隔）----
# 不要写 *。原因见 backend/main.py 顶部的说明。
CORS_ORIGINS=http://localhost:5173

# ---- 大模型 ----
# 不配置也能启动，只是 AI 回复会降级（FAQ 与规则仍可正常工作）
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# ---- Redis（幂等去重）----
# 不配置则降级为进程内实现：单实例可用，多实例会重复处理消息
REDIS_URL=
REDIS_TOKEN=

# ---- 平台 webhook 签名密钥 ----
# 用于校验 /api/webhook/{platform} 收到的推送。不配则放行（仅开发用）。
XIANYU_WEBHOOK_SECRET=
